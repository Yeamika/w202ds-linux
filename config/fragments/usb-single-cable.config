# USB-C single cable for the W202DS: USB3 + 2-lane DP alt mode (pin D, HBR2) while charging.
# ump9620-tcpc (TCPM port controller) drives roles, PD and the DP alt mode; w202_dp (Devices/usb3) is the DP glue.
# The combo PHY's DP side is a generic PHY; dwc3 must be dual-role for TCPM's data role switching.
CONFIG_GENERIC_PHY=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_TYPEC_UMP9620=m
CONFIG_TYPEC_DP_ALTMODE=m
CONFIG_DRM_DW_DP=m
# The port controller's VBUS regulator and PD power sink. bq256xx binds "ti,bq2560x_chg", the same node as
# Devices/charging w202_bq_control.ko: enable only one of the two charging stacks.
CONFIG_CHARGER_BQ256XX=m
