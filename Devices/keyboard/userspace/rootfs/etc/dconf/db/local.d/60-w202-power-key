# W200DS: w202-power-key handles the power key (short press screen off/on, long press power menu).
# Idle suspend on battery after 30 min; on external power never (50-w202-no-ac-suspend).
[org/gnome/settings-daemon/plugins/power]
power-button-action='nothing'
sleep-inactive-battery-timeout=1800

# Screen off through the power key or idle asks for the password once the screen has been off for 15 minutes
# (w202-screen-lock@w202ds; before that a swipe up on the lock screen returns to the session).
[org/gnome/desktop/screensaver]
lock-delay=uint32 900

# The power menu and screen lock are the GNOME Shell extensions w202-power-menu@w202ds and w202-screen-lock@w202ds.
# A user who changes the extension list keeps their own value instead of this default; both then have to stay in it.
[org/gnome/shell]
enabled-extensions=['w202-power-menu@w202ds', 'w202-screen-lock@w202ds']
