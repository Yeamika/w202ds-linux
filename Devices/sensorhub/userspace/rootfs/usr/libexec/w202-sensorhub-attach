#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Bind w202-hub-iio once CH has opened its SIPC pipe. w202-modem-runtime starts CH; the driver's probe
# defers until the spipe_ch ring is ready, and nothing else retries a deferred probe this late in boot.
set -eu
device=sprd-sensorhub
driver=/sys/bus/platform/drivers/w202-hub-iio

modprobe w202_hub_iio
if ! test -w "$driver/bind"; then
    echo "w202-hub-iio bind interface is unavailable; check the module and permissions." >&2
    exit 1
fi

attempt=0
while test "$attempt" -lt 30; do
    test -e "$driver/$device" && exit 0
    { printf '%s\n' "$device" > "$driver/bind"; } 2>/dev/null || :
    test -e "$driver/$device" && exit 0
    attempt=$((attempt + 1))
    if test "$attempt" -lt 30; then
        sleep 1
    fi
done
echo "$device did not bind to w202-hub-iio after 30 attempts; see the kernel log." >&2
exit 1
