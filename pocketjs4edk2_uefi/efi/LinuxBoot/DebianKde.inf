[Defines]
  INF_VERSION = 0x0001001B
  BASE_NAME = DebianKde
  FILE_GUID = 5f134426-7c31-49dc-bb59-25e2c3d17cc6
  MODULE_TYPE = UEFI_APPLICATION
  VERSION_STRING = 0.1
  ENTRY_POINT = UefiMain
[Sources]
  LinuxBoot.c
  LinuxImage.c
  LinuxImage.h
  LinuxDisplay.h
  LinuxHandoff.c
  EnterKernel.S
[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  ArmPkg/ArmPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
[LibraryClasses]
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  MemoryAllocationLib
  BaseLib
  BaseMemoryLib
  ArmLib
  IoLib
  DebugLib
  FdtLib
  TimerLib
[Protocols]
  gEfiGraphicsOutputProtocolGuid
  gEfiLoadedImageProtocolGuid
  gEfiPartitionInfoProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
[Guids]
  gEfiPartTypeSystemPartGuid
  gEfiFileInfoGuid
[BuildOptions]
  GCC:*_*_AARCH64_CC_FLAGS = -DW202_LINUX_KDE
