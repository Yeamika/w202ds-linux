/output/
/provenance/
__pycache__/
*.pyc
device.json
/Devices/reference/
/Devices/*/reference/
/Devices/*/modules/
/Devices/*/userspace/
SOURCES*.json

# Publish only the selected contents of each hardware directory.
/Devices/*/*
!/Devices/*/README.md
!/Devices/*/build.mk
!/Devices/*/devicetree/
!/Devices/*/firmware/
!/Devices/*/source/

# Publish modem userspace sources and configuration; keep delivery packages local.
!/Devices/modem/userspace/
!/Devices/modem/userspace/SOURCES.json
/Devices/modem/userspace/releases/
/Devices/modem/userspace/server-runtime-20261103-v5/
/Devices/modem/userspace/output/

# Publish USB-C single-cable userspace configuration.
!/Devices/usb3/userspace/

# Publish the GPU implementation already verified on W202DS.
/Devices/gpu/source/*
!/Devices/gpu/source/panfrost/
!/Devices/gpu/source/README.md
