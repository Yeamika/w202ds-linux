/output/
/provenance/
__pycache__/
*.pyc
device.json
/Devices/reference/
/Devices/*/reference/
/Devices/*/modules/
SOURCES*.json

# Publish only the selected contents of each hardware directory.
/Devices/*/*
!/Devices/*/README.md
!/Devices/*/build.mk
!/Devices/*/devicetree/
!/Devices/*/firmware/
!/Devices/*/source/
!/Devices/*/userspace/

# Reference snapshots and the retired diagnostic recovery project stay local.
/Devices/**/vendor-reference/
/Devices/*/source/*-vendor-reference/
/Devices/*/source/mainline-current/
/Devices/pmic/source/diagnostic-recovery/

# Publish the GPU implementation already verified on W202DS.
/Devices/gpu/source/*
!/Devices/gpu/source/panfrost/
!/Devices/gpu/source/README.md

# Userspace sources and service templates are published; build caches are not.
/Devices/*/userspace/**/output/
/Devices/*/userspace/**/build/
/Devices/*/userspace/**/components.local.json
# Independent experimental upstream checkouts are optional source caches.
/Devices/gpu/userspace/mesa/
/Devices/vpu/userspace/libva-v4l2_request/
